# ZenTask frontend environment (Vite)
# Copy this file to .env and adjust as needed.

# API origin used by the built SPA. Leave empty in development: the Vite dev
# server proxies the API paths listed in vite.config.ts to the target below.
# For a deployed build set this to the API origin, e.g. https://api.zentask.space
VITE_API_BASE=

# Where the Vite dev server proxies /auth, /tasks, /lists, ... during `npm run dev`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Web Push (VAPID public key). The matching private key, the VAPID subject,
# Gemini/Jira/Atlassian credentials, SES SMTP and the database DSN live in the
# Django backend's own .env (see zentask.api/docs/phase8-runbook.md).
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
