# ZenTask Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Jira Integration (Atlassian OAuth 2.0)
# Create an app at https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your_atlassian_client_id
# Server-side only (used in Supabase Edge Functions, set via `supabase secrets set`)
ATLASSIAN_CLIENT_SECRET=your_atlassian_client_secret

# Edge Function Requirements (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application URL (used for OAuth redirects)
APP_URL=http://localhost:5173

# Web Push Notifications (VAPID Keys)
# Public key is exposed to the frontend (VITE_ prefix)
# Private key and subject must also be set in Supabase secrets:
# supabase secrets set VAPID_PRIVATE_KEY=your_private_key
# supabase secrets set VAPID_SUBJECT=mailto:your-email@example.com
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com